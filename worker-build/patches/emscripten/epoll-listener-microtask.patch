Subject: [PATCH] Deliver epoll listener callbacks as a microtask of the notifying task

guybedford/emscripten fix/epoll-listener-microtask (86dea35bb), without its
tests. Workers bind a host task to the request that scheduled it, and a
request may only perform I/O on its own sockets. Delivering readiness from
an immediate coalesces the wakes of concurrent requests into the first
one's task, which then accepts and serves the other requests' connections.

Base-commit: 777e6e5db (tag 7.0.0)

---
diff --git a/src/lib/libepoll.js b/src/lib/libepoll.js
--- a/src/lib/libepoll.js
+++ b/src/lib/libepoll.js
@@ -345,6 +345,10 @@ var EpollLibrary = {
     it.listener.listeners.delete(it.listener.entry);
   },
 
+  // Set while a listener callback runs.
+  $epollDelivering__internal: true,
+  $epollDelivering: 0,
+
   // See <emscripten/epoll.h>. A listener is keyed by (callback, userdata) and
   // signals the callback while the set has uncollected ready events.
   emscripten_epoll_listener_add__deps: ['$epollClearListener'],
@@ -362,22 +366,33 @@ var EpollLibrary = {
     var it = {key};
     stream.listeners.set(key, it);
 
-    // Every delivery is an event-loop task, never under the notifying wasm
-    // call's frames. At most one task is pending per listener: a turn
-    // re-derives readiness, so it covers every wake before it.
+    // A wake is delivered as a microtask: after the notifying wasm call's
+    // frames, but within the host task that made the set ready. A wake under a
+    // listener callback, or a set the callback leaves ready, is redelivered
+    // from an immediate instead, yielding to I/O. At most one of each is
+    // pending per listener: a turn re-derives readiness, so it covers every
+    // wake before it.
+    var pending = [];
     function schedule() {
-      if (it.pending) return;
-      it.pending = true;
-      emSetImmediate(turn);
+      var defer = epollDelivering;
+      if (pending[defer]) return;
+      pending[defer] = true;
+      (defer ? emSetImmediate : queueMicrotask)(() => {
+        pending[defer] = false;
+        turn();
+      });
     }
     function turn() {
-      it.pending = false;
       if (it.cleared || epollWouldBlock(ep)) return;
-      callUserCallback(() => {
-        {{{ makeDynCall('vip', 'callback') }}}(epfd, userdata);
-        // A still-ready level fd yields to I/O before the next delivery.
-        if (!it.cleared && !epollWouldBlock(ep)) schedule();
-      });
+      epollDelivering = 1;
+      try {
+        callUserCallback(() => {
+          {{{ makeDynCall('vip', 'callback') }}}(epfd, userdata);
+          if (!it.cleared && !epollWouldBlock(ep)) schedule();
+        });
+      } finally {
+        epollDelivering = 0;
+      }
     }
     it.listener = ep.node.addListener(schedule);
     schedule();
diff --git a/system/include/emscripten/epoll.h b/system/include/emscripten/epoll.h
--- a/system/include/emscripten/epoll.h
+++ b/system/include/emscripten/epoll.h
@@ -38,15 +38,22 @@ extern "C" {
 // is collected by exactly one listener (load balancing), while a level fd keeps
 // signalling every listener until drained.
 //
-// A listener fires on a later event-loop turn, never from within a running wasm
-// call, while the set has ready events that have not yet been collected, and
-// keeps firing while any remain: it only signals that events are pending, so a
-// callback that does not drain them (via epoll_wait) leaves them pending and
-// re-fires. Whether a given fd is re-reported follows its per-fd trigger mode
-// (set via epoll_ctl) exactly as epoll_wait does. Note that for a level-triggered
-// fd the runtime, not the application, drives the loop, so an fd that is
-// structurally always ready (notably EPOLLOUT on a writable socket) will spin
-// the event loop; use EPOLLET or EPOLLONESHOT for such fds.
+// A listener fires while the set has ready events that have not yet been
+// collected, never from within a running wasm call. When the set becomes ready
+// the callback runs as a microtask: after the call that made it ready returns,
+// and before the event-loop task that call ran in ends. Hosts that tie I/O to
+// the task it arrived in therefore see each fd handled in its own task.
+//
+// The listener keeps firing while events remain: it only signals that events
+// are pending, so a callback that does not drain them (via epoll_wait) leaves
+// them pending and re-fires. These re-fires, like any readiness raised from
+// within a listener callback, are delivered on a later event-loop turn rather
+// than as a microtask, yielding to I/O and timers in between. Whether a given
+// fd is re-reported follows its per-fd trigger mode (set via epoll_ctl) exactly
+// as epoll_wait does. Note that for a level-triggered fd the runtime, not the
+// application, drives the loop, so an fd that is structurally always ready
+// (notably EPOLLOUT on a writable socket) will spin the event loop; use EPOLLET
+// or EPOLLONESHOT for such fds.
 //
 // A listener is an unref'd handle (like Node's handle.unref()): while the
 // runtime is alive, readiness is delivered to it, but it never keeps the
